# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment（ANTHROPIC_API_KEY を含む。絶対にコミットしない）
.env
.env.*
!.env.example
backend/.env

# Frontend
node_modules/
.next/
out/

# Generated
frontend/src/shared/api/generated/
backend/openapi.json

# 原本と出力 Excel（⑤ #4 が保管する。実データなのでコミットしない）
backend/storage/

# Agent traces（エージェント実行トレース。設計との突き合わせ用ローカルログ）
# ディレクトリ自体は .gitkeep で残す（クローン直後に backend/traces/ が無いと初回実行が失敗するため）
backend/traces/*
!backend/traces/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# ビルド生成物（スラッシュなしの build/ は docs/build/ まで除外してしまうため、配下を明示する）
frontend/dist/
frontend/build/
backend/dist/
backend/build/
